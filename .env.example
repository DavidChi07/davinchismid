# Backend - copiar como .env y llenar con datos LOCALES (nunca los de producción)

# Cadena de conexión a Postgres local
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/davinchismid

# Puerto donde corre el backend
PORT=3000

# Nombre de la app (usado en el log de inicio)
APP_NAME=DavinchisMid

# Secret para firmar JWT (cualquier string largo y aleatorio sirve en local)
JWT_SECRET=cambia_esto_por_un_secreto_local